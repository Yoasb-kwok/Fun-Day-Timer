# Railway Postgres connection string. Required on Vercel Production.
# Use the public host so Vercel can reach it. Do not commit a real password.
# Example: postgres://user:password@host.example:5432/railway?sslmode=require
DATABASE_URL=postgres://fun_day:fun_day@127.0.0.1:5432/fun_day_test

# Optional. Signs the helper session cookie. When unset, the key is derived from
# DATABASE_URL so every instance that shares the database accepts the same cookie.
SESSION_SECRET=
